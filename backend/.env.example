# Required — the app's persistence layer (projects, tickets, team, health
# history, runtime settings, activity log). Project Settings > API in your
# Supabase dashboard. Needed even for local dev with USE_MOCK_DATA=true; use
# the Supabase CLI's local stack (`supabase start`) if you want that dev
# loop to stay fully offline.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=xxxx

ANTHROPIC_API_KEY=sk-ant-xxxx
JIRA_BASE_URL=https://yourorg.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=xxxx
JIRA_BOARD_ID=42
JIRA_SPRINT_ID=current
# Jira custom field IDs vary per instance — check yours under
# Jira settings > Issues > Custom fields.
JIRA_STORY_POINTS_FIELD=customfield_10016
JIRA_AC_FIELD=customfield_10100
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
# USE_MOCK_DATA / STALE_THRESHOLD_HOURS / STUCK_THRESHOLD_PCT / SPRINT_TOTAL_DAYS
# are live-editable at runtime from the Settings page and stored in
# Supabase's runtime_settings table, not read from .env at request time.
# The values below are used once, as the initial rows written by
# migrations/seed_supabase.py when bootstrapping a fresh Supabase project.
# true (default): always use the seeded project/ticket data.
# false: fetch from JIRA_BASE_URL per-project (falls back to mock on any error).
USE_MOCK_DATA=true
# Shared secret for POST /api/webhooks/git — the caller must send an
# X-Webhook-Signature header = hex HMAC-SHA256(secret, raw_body).
# Leave blank only for local/demo use; requests are unsigned without it.
GIT_WEBHOOK_SECRET=
STALE_THRESHOLD_HOURS=24
STUCK_THRESHOLD_PCT=50
SPRINT_TOTAL_DAYS=10
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=INFO
SCHEDULER_ENABLED=false
SCHEDULER_TIME_UTC=09:00
EMAIL_DRY_RUN=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_RECIPIENTS_CHK=
EMAIL_RECIPIENTS_PAY=
EMAIL_RECIPIENTS_SRCH=
EMAIL_RECIPIENTS_AUTH=

# Minutes before a demo login session expires and bounces the user back to
# the login screen. Lower temporarily (e.g. 0.5) to test expiry quickly.
AUTH_SESSION_TTL_MINUTES=30
